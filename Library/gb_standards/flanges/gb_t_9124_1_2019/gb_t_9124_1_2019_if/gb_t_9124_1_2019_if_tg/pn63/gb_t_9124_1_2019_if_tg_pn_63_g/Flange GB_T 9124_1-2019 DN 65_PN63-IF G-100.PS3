					"RCCINS{NAME{\"ECLASSREF\"}RCIPL{RCIPS{NAME{\"CLASSNAME\"}VALUE{\"cns\"}}RCIPS{NAME{\"CLASSID\"}VALUE{\"CNS_CP_PLACE_PA\"}}RCIPS{NAME{\"INSTID\"}VALUE{\"0\"}}}}"
				}
			}
		}
	}
}